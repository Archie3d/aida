set(AIDA_SANITIZER "none" CACHE STRING "Validation build: none, address-undefined, thread")
set_property(CACHE AIDA_SANITIZER PROPERTY STRINGS none address-undefined thread)
set(AIDA_SANITIZER_FLAG "")
if(AIDA_SANITIZER STREQUAL "address-undefined")
    set(AIDA_SANITIZER_FLAG "-fsanitize=address,undefined")
elseif(AIDA_SANITIZER STREQUAL "thread")
    set(AIDA_SANITIZER_FLAG "-fsanitize=thread")
elseif(NOT AIDA_SANITIZER STREQUAL "none")
    message(FATAL_ERROR "Unknown AIDA_SANITIZER=${AIDA_SANITIZER}")
endif()
if(AIDA_SANITIZER_FLAG)
    if(NOT CMAKE_C_COMPILER_ID MATCHES "Clang|GNU" OR NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
        message(FATAL_ERROR "Sanitizer validation requires Clang or GCC")
    endif()
    add_compile_options(${AIDA_SANITIZER_FLAG} -fno-omit-frame-pointer -g)
    add_link_options(${AIDA_SANITIZER_FLAG})
    if(AIDA_SANITIZER STREQUAL "address-undefined")
        add_compile_options(-fno-sanitize-recover=all)
    endif()
endif()
