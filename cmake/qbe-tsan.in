#!/usr/bin/env python3
# IR pass versions: @AIDA_TSAN_PASS_DIGEST@ @AIDA_TSAN_ADAPTER_DIGEST@
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, "@AIDA_TSAN_TOOLS@")
