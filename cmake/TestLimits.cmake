set(AIDA_TEST_TIMEOUT 180 CACHE STRING "Fallback deadline in seconds for each CTest test")
if(NOT AIDA_TEST_TIMEOUT MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "AIDA_TEST_TIMEOUT must be a positive integer")
endif()
# Called in each test directory after registration; explicit tighter limits win.
function(aida_finalize_tests)
    get_property(tests DIRECTORY PROPERTY TESTS)
    foreach(test IN LISTS tests)
        if(AIDA_SANITIZER_FLAG)
            set_property(TEST "${test}" APPEND PROPERTY ENVIRONMENT "AIDA_TEST_SANITIZER_FLAG=${AIDA_SANITIZER_FLAG}")
        endif()
        get_property(timeout TEST "${test}" PROPERTY TIMEOUT)
        if(NOT timeout)
            set_tests_properties("${test}" PROPERTIES TIMEOUT ${AIDA_TEST_TIMEOUT})
        endif()
    endforeach()
endfunction()
