set(work "${WORKDIR}/hierarchical-layouts")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/library/tree/branch" "${work}/library/other" "${work}/later/tree/branch")
set(library "${work}/library")
file(WRITE "${library}/tree.ads" "package Tree is end Tree;\n")
file(WRITE "${library}/tree/branch.ads" "package Tree.Branch is end Tree.Branch;\n")
file(WRITE "${library}/tree/branch/leaf.ads" "package Tree.Branch.Leaf is function Value return Integer; end Tree.Branch.Leaf;\n")
# Mix a flat body with a hierarchical spec, then a hierarchical subunit.
file(WRITE "${library}/tree-branch-leaf.adb" "package body Tree.Branch.Leaf is function Value return Integer is separate; end Tree.Branch.Leaf;\n")
file(WRITE "${library}/tree/branch/leaf-value.adb" "procedure Wrong is begin null; end Wrong;\n")
file(MAKE_DIRECTORY "${library}/tree/branch/leaf")
file(WRITE "${library}/tree/branch/leaf/value.adb" "separate (Tree.Branch.Leaf) function Value return Integer is begin return 7; end Value;\n")
# A second child with the same leaf name must have a distinct artifact key.
file(WRITE "${library}/other.ads" "package Other is end Other;\n")
file(WRITE "${library}/other/leaf.ads" "package Other.Leaf is Value : constant Integer := 2; end Other.Leaf;\n")
file(WRITE "${work}/layout_check.adb" "with Ada.Text_IO; with Tree.Branch.Leaf; with Other.Leaf;
procedure Layout_Check is begin Ada.Text_IO.Put_Line (Integer'Image (Tree.Branch.Leaf.Value + Other.Leaf.Value)); end Layout_Check;\n")
if(CMAKE_HOST_WIN32)
    set(separator ";")
else()
    set(separator ":")
endif()
function(build_run expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "ADA_INCLUDE_PATH=${library}${separator}${work}/later" "${ADA}" -v -D "${work}/objects"
        -o "${work}/program" "${work}/layout_check.adb"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 40)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "hierarchical build: ${status}\n${output}${errors}")
    endif()
    set(commands "${errors}" PARENT_SCOPE)
    execute_process(COMMAND "${work}/program" RESULT_VARIABLE status OUTPUT_VARIABLE output TIMEOUT 10)
    if(NOT status STREQUAL "0" OR NOT output STREQUAL " ${expected}\n")
        message(FATAL_ERROR "hierarchical output: ${status}: ${output}")
    endif()
endfunction()
# A later flat file cannot shadow the earlier hierarchical source, even when
# the later root contains a conflicting pair.
file(WRITE "${work}/later/tree-branch-leaf.ads" "invalid Ada\n")
file(WRITE "${work}/later/tree/branch/leaf.ads" "invalid Ada\n")
build_run(9)
foreach(key tree-branch-leaf other-leaf)
    if(NOT EXISTS "${work}/objects/${key}.ali")
        message(FATAL_ERROR "missing distinct artifact ${key}")
    endif()
endforeach()
build_run(9)
if(NOT commands MATCHES "tree-branch-leaf needs no compiling" OR NOT commands MATCHES "layout_check needs no compiling")
    message(FATAL_ERROR "hierarchical cache miss: ${commands}")
endif()
file(WRITE "${library}/tree/branch/leaf/value.adb" "separate (Tree.Branch.Leaf) function Value return Integer is begin return 8; end Value;\n")
build_run(10)
if(commands MATCHES "tree-branch-leaf needs no compiling")
    message(FATAL_ERROR "hierarchical subunit edit was cached")
endif()
# Compile hierarchical sources explicitly, including equal leaf filenames.
execute_process(COMMAND "${ADAC}" -c -I "${library}" -D "${work}/explicit"
    "${library}/other/leaf.ads" "${library}/tree/branch/leaf.ads"
    RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 20)
if(NOT status STREQUAL "0" OR NOT EXISTS "${work}/explicit/tree-branch-leaf.ssa")
    message(FATAL_ERROR "explicit hierarchical target: ${status}\n${errors}")
endif()
function(reject diagnostic)
    execute_process(COMMAND "${ADAC}" --scan -I "${library}" -D "${work}/rejected" "${work}/layout_check.adb"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 15)
    if(NOT status STREQUAL "1" OR NOT errors MATCHES "${diagnostic}")
        message(FATAL_ERROR "expected ${diagnostic}: ${status}\n${errors}")
    endif()
endfunction()
file(WRITE "${library}/tree-branch-leaf.ads" "package Tree.Branch.Leaf is end Tree.Branch.Leaf;\n")
reject("conflicting sources for 'tree-branch-leaf.ads'")
file(REMOVE "${library}/tree-branch-leaf.ads")
file(COPY_FILE "${library}/tree-branch-leaf.adb" "${library}/tree/branch/leaf.adb")
reject("conflicting sources for 'tree-branch-leaf.adb'")
file(REMOVE "${library}/tree-branch-leaf.adb")
build_run(10)
# A second spelling of the same physical source is an alias, not a conflict.
file(CREATE_LINK "${library}/tree/branch/leaf.ads" "${library}/tree-branch-leaf.ads"
    SYMBOLIC RESULT link_status)
if(link_status STREQUAL "0")
    build_run(10)
    file(REMOVE "${library}/tree-branch-leaf.ads")
endif()
# Whole-program and per-unit lowering must agree for hierarchical objects.
execute_process(COMMAND "${ADAC}" -I "${library}" -D "${work}/whole" "${work}/layout_check.adb"
    RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 20)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "whole hierarchical lowering: ${status}\n${errors}")
endif()
foreach(key tree-branch tree-branch-leaf other-leaf layout_check)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
        "${work}/whole/${key}.ssa" "${work}/objects/${key}.ssa" RESULT_VARIABLE status)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "whole/per-unit hierarchical IR differs for ${key}")
    endif()
endforeach()
file(WRITE "${library}/tree/branch/leaf.adb" "package body Wrong is end Wrong;\n")
reject("does not declare library unit")
file(REMOVE "${library}/tree/branch/leaf.adb")
file(WRITE "${library}/tree/branch/leaf.ads" "package Wrong is end Wrong;\n")
reject("does not declare library unit")
file(WRITE "${library}/tree/branch/leaf.adb" "package body Tree.Branch.Leaf is function Value return Integer is separate; end Tree.Branch.Leaf;\n")
# Hierarchical generic bodies must be loaded during per-unit client analysis,
# and template body edits must invalidate clients.
file(WRITE "${library}/tree/branch/leaf.ads" "package Tree.Branch.Leaf is function Value return Integer; end Tree.Branch.Leaf;\n")
file(WRITE "${library}/tree/template.ads" "generic type Item is range <>;
package Tree.Template is function Value return Item; end Tree.Template;\n")
file(WRITE "${library}/tree/template.adb" "package body Tree.Template is
function Value return Item is begin return 3; end Value; end Tree.Template;\n")
file(WRITE "${work}/layout_check.adb" "with Ada.Text_IO; with Tree.Branch.Leaf; with Other.Leaf; with Tree.Template;
procedure Layout_Check is package Instance is new Tree.Template (Integer);
begin Ada.Text_IO.Put_Line (Integer'Image (Tree.Branch.Leaf.Value + Other.Leaf.Value + Instance.Value)); end Layout_Check;\n")
build_run(13)
build_run(13)
if(NOT commands MATCHES "layout_check needs no compiling")
    message(FATAL_ERROR "hierarchical generic client cache miss: ${commands}")
endif()
file(READ "${library}/tree/template.adb" template)
string(REPLACE "return 3" "return 4" template "${template}")
file(WRITE "${library}/tree/template.adb" "${template}")
build_run(14)
if(commands MATCHES "layout_check needs no compiling")
    message(FATAL_ERROR "hierarchical generic body edit did not invalidate client")
endif()
# Reverse the layout choice: an earlier flat spec also beats a later hierarchy.
file(RENAME "${library}/tree/branch/leaf.ads" "${library}/tree-branch-leaf.ads")
build_run(14)
