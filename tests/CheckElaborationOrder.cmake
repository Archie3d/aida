set(work "${WORKDIR}/elaboration-order")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
execute_process(COMMAND "${ADA}" -D "${work}/objects" -o "${work}/program" "${SOURCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "build failed: ${output}${errors}")
endif()
set(manifest "${work}/objects/units.manifest")
file(READ "${manifest}" original)

function(reject text pattern)
    file(WRITE "${manifest}" "${text}")
    execute_process(COMMAND "${ADAC}" --bind load_main -D "${work}/objects"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
    if(NOT "${status}" MATCHES "^[1-9][0-9]*$" OR NOT errors MATCHES "${pattern}")
        message(FATAL_ERROR "expected ${pattern}: ${status}\n${output}${errors}")
    endif()
endfunction()

string(REPLACE "elaborate load_b.spec\n" "" missing "${original}")
reject("${missing}" "missing elaboration entry 'load_b.spec'")
string(REPLACE "elaborate load_b.spec\n" "elaborate load_b.spec\nelaborate load_b.spec\n" duplicate "${original}")
reject("${duplicate}" "duplicate elaboration entry 'load_b.spec'")
string(REPLACE "elaborate load_b.spec\n" "elaborate nonexistent.spec\n" unknown "${original}")
reject("${unknown}" "unknown elaboration entry 'nonexistent.spec'")
string(REPLACE "elaborate load_b.spec\n" "elaborate TEMP\n" reordered "${original}")
string(REPLACE "elaborate load_b.body\n" "elaborate load_b.spec\n" reordered "${reordered}")
string(REPLACE "elaborate TEMP\n" "elaborate load_b.body\n" reordered "${reordered}")
reject("${reordered}" "invalid elaboration order:")
string(REPLACE "requires load_b.spec\n" "requires nonexistent.spec\n" unknown_dependency "${original}")
reject("${unknown_dependency}" "unknown elaboration dependency 'nonexistent.spec'")
string(REPLACE "part load_b.spec\n" "part load_b.spec\npart load_b.spec\n" duplicate_part "${original}")
reject("${duplicate_part}" "duplicate elaboration part 'load_b.spec'")
string(REGEX REPLACE "end\n$" "" truncated "${original}")
reject("${truncated}" "cannot read")
file(WRITE "${manifest}" "${original}")
execute_process(COMMAND "${ADAC}" --bind load_main -D "${work}/objects"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "valid order rejected: ${output}${errors}")
endif()
