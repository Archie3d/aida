# Construct both byte encodings explicitly, independent of Git checkout policy.
file(READ "${SOURCE}" source)
file(READ "${EXPECTED}" expected)
string(REPLACE "\r\n" "\n" source "${source}")
string(REPLACE "\r\n" "\n" expected "${expected}")
get_filename_component(base "${SOURCE}" NAME)
foreach(ending lf crlf)
    set(work "${WORKDIR}/string-line-endings/${ending}")
    file(MAKE_DIRECTORY "${work}")
    set(text "${source}")
    if(ending STREQUAL "crlf")
        string(REPLACE "\n" "\r\n" text "${text}")
    endif()
    set(probe "${work}/${base}")
    file(WRITE "${probe}" "${text}")
    execute_process(COMMAND "${ADAC}" -o "${work}/probe.ssa" "${probe}"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 10)
    string(REPLACE "${probe}" "${base}" errors "${errors}")
    string(REPLACE "\r\n" "\n" errors "${errors}")
    if(NOT status EQUAL 1 OR NOT errors STREQUAL expected)
        message(FATAL_ERROR "Unexpected ${ending} diagnostics (${status}):\n${errors}")
    endif()
    # CR at a line boundary must not suppress diagnostics for actual controls.
    set(text "procedure ControlErrors is\n    Text : String := \"bad\ttext\";\nbegin\n    null;\nend ControlErrors;\n")
    if(ending STREQUAL "crlf")
        string(REPLACE "\n" "\r\n" text "${text}")
    endif()
    set(probe "${work}/controlerrors.adb")
    file(WRITE "${probe}" "${text}")
    execute_process(COMMAND "${ADAC}" -o "${work}/control.ssa" "${probe}"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 10)
    string(REPLACE "${probe}" "controlerrors.adb" errors "${errors}")
    string(REPLACE "\r\n" "\n" errors "${errors}")
    if(NOT status EQUAL 1 OR NOT errors STREQUAL
        "controlerrors.adb:2:22: error: a string literal requires graphic characters\n")
        message(FATAL_ERROR "Unexpected ${ending} control diagnostics (${status}):\n${errors}")
    endif()
endforeach()
