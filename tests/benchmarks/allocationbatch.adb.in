with Ada.Unchecked_Deallocation;
procedure AllocationBatch is
    kLiveObjects : constant Integer := @LIVE_OBJECTS@;
    kRounds : constant Integer := @ROUNDS@;
    type Pointer is access Integer;
    type PointerTable is array (1 .. kLiveObjects) of Pointer;
    type TableAccess is access PointerTable;
    procedure Free is new Ada.Unchecked_Deallocation (Integer, Pointer);
    procedure FreeTable is new Ada.Unchecked_Deallocation (PointerTable, TableAccess);
    Items : TableAccess := new PointerTable;
    Total : Long_Integer := 0;
begin
    for Round in 1 .. kRounds loop
        for I in 1 .. kLiveObjects loop
            Items (I) := new Integer'(I);
        end loop;
        for I in 1 .. kLiveObjects loop
            declare
                Position : Integer := @POSITION@;
            begin
                Total := Total + Long_Integer (Items (Position).all);
                Free (Items (Position));
                if Items (Position) /= null then
                    raise Program_Error;
                end if;
            end;
        end loop;
    end loop;
    FreeTable (Items);
    if Items /= null or Total /= Long_Integer (kRounds) * Long_Integer (kLiveObjects)
        * Long_Integer (kLiveObjects + 1) / 2 then
        raise Program_Error;
    end if;
end AllocationBatch;
