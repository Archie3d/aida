file(MAKE_DIRECTORY "${WORKDIR}")
set(math_library)
if(SEPARATE_LIBM)
    set(math_library -lm)
endif()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGV}\n${status}\n${output}${errors}")
    endif()
    set(actual "${output}" PARENT_SCOPE)
endfunction()
foreach(mode whole separate)
    set(program "${WORKDIR}/${mode}")
    if(mode STREQUAL whole)
        run("${ADA}" -S -o "${program}.s" "${SOURCE}")
    else()
        file(REMOVE_RECURSE "${WORKDIR}/units")
        run("${ADAC}" -D "${WORKDIR}/units" "${SOURCE}")
        file(STRINGS "${WORKDIR}/units/units.manifest" manifest)
        set(assembly)
        foreach(entry IN LISTS manifest)
            if(entry MATCHES "^source (.*)$")
                run("${ADAC}" -c -D "${WORKDIR}/units" "${CMAKE_MATCH_1}")
            endif()
        endforeach()
        run("${ADAC}" --bind taskconcurrency -D "${WORKDIR}/units" -o "${WORKDIR}/units/__ada_binder.ssa")
        file(GLOB ir "${WORKDIR}/units/*.ssa")
        foreach(unit IN LISTS ir)
            run("${QBE}" -o "${unit}.s" "${unit}")
            list(APPEND assembly "${unit}.s")
        endforeach()
    endif()
    if(mode STREQUAL whole)
        set(assembly "${program}.s")
    endif()
    run("${CC}" -std=c11 -pthread ${SANITIZER_FLAGS} ${assembly} "${HELPERS}" "${RUNTIME}"
        ${math_library} -o "${program}")
    run("${program}")
    if(NOT actual STREQUAL "task concurrency passed\n")
        message(FATAL_ERROR "Unexpected ${mode} output: ${actual}")
    endif()
endforeach()
