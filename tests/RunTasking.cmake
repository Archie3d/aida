if(DEFINED PRIORITY_PROBE)
    execute_process(COMMAND "${PRIORITY_PROBE}" interrupt
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
    if(status STREQUAL "77" AND errors STREQUAL ""
        AND output MATCHES "^maximum native task priority unavailable: ")
        message(STATUS "SKIP native interrupt priority unavailable: ${output}")
        return()
    endif()
    if(NOT status STREQUAL "0" OR NOT output STREQUAL "" OR NOT errors STREQUAL "")
        message(FATAL_ERROR "Native interrupt priority prerequisite failed: ${status}\n${output}${errors}")
    endif()
endif()
include(${CMAKE_CURRENT_LIST_DIR}/ProcessLimits.cmake)
get_filename_component(main_unit "${SOURCE}" NAME_WE)
string(REPLACE "|" ";" extra_sources "${EXTRA_SOURCES}")
set(helper_sources)
if(DEFINED HELPERS)
    list(APPEND helper_sources "${HELPERS}")
endif()
set(expected "task concurrency passed\n")
if(DEFINED ACATS_REPORT_NAME)
    set(expected "TEST ${ACATS_REPORT_NAME}\nPASSED\n")
endif()
if(DEFINED EXPECTED)
    file(READ "${EXPECTED}" expected)
endif()
file(MAKE_DIRECTORY "${WORKDIR}")
set(math_library)
if(SEPARATE_LIBM)
    set(math_library -lm)
endif()
set(qbe_target)
if(WIN32)
    list(APPEND qbe_target -t amd64_win)
endif()
if(NOT DEFINED COMMAND_TIMEOUT)
    set(COMMAND_TIMEOUT ${AIDA_COMPILE_TIMEOUT})
endif()
function(run)
    set(timeout ${COMMAND_TIMEOUT})
    if(ARGC EQUAL 1)
        set(timeout ${AIDA_RUN_TIMEOUT})
    endif()
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT ${timeout})
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Command failed: ${ARGV}\n${status}\n${output}${errors}")
    endif()
    set(actual "${output}" PARENT_SCOPE)
endfunction()
foreach(mode whole separate)
    set(program "${WORKDIR}/${mode}")
    if(mode STREQUAL whole)
        set(source_options)
        if(SOURCE_AS_ADA)
            list(APPEND source_options --source)
        endif()
        run("${ADA}" -S -o "${program}.s" ${extra_sources} ${source_options} "${SOURCE}")
    else()
        file(REMOVE_RECURSE "${WORKDIR}/units")
        run("${ADAC}" -D "${WORKDIR}/units" ${extra_sources} "${SOURCE}")
        file(STRINGS "${WORKDIR}/units/units.manifest" manifest)
        set(assembly)
        foreach(entry IN LISTS manifest)
            if(entry MATCHES "^source (.*)$")
                run("${ADAC}" -c -D "${WORKDIR}/units" ${extra_sources} "${CMAKE_MATCH_1}")
            endif()
        endforeach()
        run("${ADAC}" --bind "${main_unit}" -D "${WORKDIR}/units" -o "${WORKDIR}/units/__ada_binder.ssa")
        file(GLOB ir "${WORKDIR}/units/*.ssa")
        foreach(unit IN LISTS ir)
            if(DEFINED FORBIDDEN_SYMBOL)
                file(READ "${unit}" generated)
                string(FIND "${generated}" "${FORBIDDEN_SYMBOL}" found)
                if(NOT found EQUAL -1)
                    message(FATAL_ERROR "Unexpected ${FORBIDDEN_SYMBOL} in ${unit}")
                endif()
            endif()
            run("${QBE}" ${qbe_target} -o "${unit}.s" "${unit}")
            if(WIN32)
                if(NOT DEFINED STACK_PROBE)
                    message(FATAL_ERROR "Windows raw-QBE modes require STACK_PROBE")
                endif()
                run("${STACK_PROBE}" "${unit}.s")
            endif()
            list(APPEND assembly "${unit}.s")
        endforeach()
    endif()
    if(mode STREQUAL whole)
        set(assembly "${program}.s")
    endif()
    run("${CC}" -std=c11 -pthread ${SANITIZER_FLAGS} ${assembly} ${helper_sources} "${RUNTIME}"
        ${math_library} -o "${program}")
    run("${program}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Unexpected ${mode} output: ${actual}")
    endif()
endforeach()
