set(work "${WORKDIR}/unitloading-${CASE}")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
file(COPY "${FIXTURES}/" DESTINATION "${work}")

function(scan)
    execute_process(COMMAND "${ADAC}" --scan -D "${work}/objects" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
    set(status "${status}" PARENT_SCOPE)
    set(errors "${errors}" PARENT_SCOPE)
endfunction()

function(require_success)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "scan failed: ${status}\n${errors}")
    endif()
endfunction()

function(require_error pattern)
    if(NOT "${status}" MATCHES "^[1-9][0-9]*$" OR NOT errors MATCHES "${pattern}")
        message(FATAL_ERROR "expected '${pattern}': ${status}\n${errors}")
    endif()
endfunction()

if(CASE STREQUAL "cycles")
    scan("${work}/cycle_a.ads")
    require_error("library dependency cycle: .*cycle_[ab].spec")
    scan("${work}/cycle_b.ads" "${work}/cycle_a.ads")
    require_error("library dependency cycle:")
    file(WRITE "${work}/self.ads" "with Self;\npackage Self is end Self;\n")
    scan("${work}/self.ads")
    require_error("library dependency cycle: self.spec -> self.spec")
    file(WRITE "${work}/body_a.adb" "with Body_B;\nprocedure Body_A is begin null; end Body_A;\n")
    file(WRITE "${work}/body_b.adb" "with Body_A;\nprocedure Body_B is begin null; end Body_B;\n")
    scan("${work}/body_a.adb")
    require_error("library dependency cycle:")
elseif(CASE STREQUAL "identity")
    # Explicit filenames remain an extension; names reached through with
    # clauses must match the declaration found through library lookup.
    scan("${work}/wrong_name.ads")
    require_success()
    scan("${work}/wrong_main.adb")
    require_error("does not declare library unit 'Wrong_Name'")
    file(MAKE_DIRECTORY "${work}/duplicate")
    file(COPY "${work}/load_b.ads" DESTINATION "${work}/duplicate")
    scan("${work}/load_b.ads" "${work}/duplicate/load_b.ads")
    require_error("conflicting explicit sources")
    file(COPY_FILE "${work}/load_b.ads" "${work}/alias.ads")
    scan("${work}/alias.ads" "${work}/load_b.ads")
    require_error("duplicate library unit part 'load_b.spec'")
    file(WRITE "${work}/missing.adb" "with Absent;\nprocedure Missing is begin null; end Missing;\n")
    scan("${work}/missing.adb")
    require_error("cannot find the unit 'Absent'")
elseif(CASE STREQUAL "sources")
    # A body explicitly named first must still load its specification; repeated
    # paths, including a symlink, must not elaborate the source twice.
    file(CREATE_LINK "${work}/load_b.adb" "${work}/body_alias.adb" SYMBOLIC RESULT link_status)
    set(alias_source "")
    if(link_status STREQUAL "0")
        set(alias_source "${work}/body_alias.adb")
    endif()
    scan("${work}/load_b.adb" "${work}/load_b.ads" "${work}/./load_b.adb"
        ${alias_source} "${work}/load_main.adb")
    require_success()
    file(READ "${work}/objects/units.manifest" manifest)
    string(REGEX MATCHALL "elaborate load_b.body\n" bodies "${manifest}")
    list(LENGTH bodies body_count)
    if(NOT body_count EQUAL 1 OR NOT manifest MATCHES "part load_b.body\nrequires load_b.spec\nrequires load_a.spec")
        message(FATAL_ERROR "lost source identity or body dependencies:\n${manifest}")
    endif()
    if(NOT manifest MATCHES "part load_a.spec\nrequires load_b.spec")
        message(FATAL_ERROR "lost specification dependency:\n${manifest}")
    endif()
    scan("${work}/load_b.ads")
    require_success()
    file(READ "${work}/objects/units.manifest" manifest)
    if(NOT manifest MATCHES "elaborate load_b.body")
        message(FATAL_ERROR "explicit specification omitted its body")
    endif()
    scan("${work}/load_b.ads" "${work}/load_b.adb" "${work}/load_main.adb")
    require_success()
elseif(CASE STREQUAL "child")
    scan("${work}/load_parent-child.ads" "${work}/child_main.adb")
    require_success()
    file(READ "${work}/objects/units.manifest" manifest)
    if(NOT manifest MATCHES "part load_parent-child.spec\nrequires load_parent.spec")
        message(FATAL_ERROR "lost parent dependency:\n${manifest}")
    endif()
    file(WRITE "${work}/absent-child.ads" "package Absent.Child is end Absent.Child;\n")
    scan("${work}/absent-child.ads")
    require_error("cannot find parent unit 'Absent'")
else()
    message(FATAL_ERROR "unknown unit loading case '${CASE}'")
endif()
