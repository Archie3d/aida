set(work "${WORKDIR}/unitloading-${CASE}")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
file(COPY "${FIXTURES}/" DESTINATION "${work}")

function(scan)
    execute_process(COMMAND "${ADAC}" --scan -D "${work}/objects" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
    set(status "${status}" PARENT_SCOPE)
    set(errors "${errors}" PARENT_SCOPE)
endfunction()

function(require_success)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "scan failed: ${status}\n${errors}")
    endif()
endfunction()

function(require_error pattern)
    if(NOT "${status}" MATCHES "^[1-9][0-9]*$" OR NOT errors MATCHES "${pattern}")
        message(FATAL_ERROR "expected '${pattern}': ${status}\n${errors}")
    endif()
endfunction()

if(CASE STREQUAL "cycles")
    scan("${work}/cycle_a.ads")
    require_error("library dependency cycle: .*cycle_[ab].spec")
    scan("${work}/cycle_b.ads" "${work}/cycle_a.ads")
    require_error("library dependency cycle:")
    file(WRITE "${work}/self.ads" "with Self;\npackage Self is end Self;\n")
    scan("${work}/self.ads")
    require_error("library dependency cycle: self.spec -> self.spec")
    file(WRITE "${work}/body_a.adb" "with Body_B;\nprocedure Body_A is begin null; end Body_A;\n")
    file(WRITE "${work}/body_b.adb" "with Body_A;\nprocedure Body_B is begin null; end Body_B;\n")
    scan("${work}/body_a.adb")
    require_error("library dependency cycle:")
elseif(CASE STREQUAL "identity")
    # Explicit filenames remain an extension; names reached through with
    # clauses must match the declaration found through library lookup.
    scan("${work}/wrong_name.ads")
    require_success()
    scan("${work}/wrong_main.adb")
    require_error("does not declare library unit 'Wrong_Name'")
    file(MAKE_DIRECTORY "${work}/duplicate")
    file(COPY "${work}/load_b.ads" DESTINATION "${work}/duplicate")
    scan("${work}/load_b.ads" "${work}/duplicate/load_b.ads")
    require_error("conflicting explicit sources")
    file(COPY_FILE "${work}/load_b.ads" "${work}/alias.ads")
    scan("${work}/alias.ads" "${work}/load_b.ads")
    require_error("duplicate library unit part 'load_b.spec'")
    file(WRITE "${work}/missing.adb" "with Absent;\nprocedure Missing is begin null; end Missing;\n")
    scan("${work}/missing.adb")
    require_error("cannot find the unit 'Absent'")
elseif(CASE STREQUAL "sources")
    # A body explicitly named first must still load its specification; repeated
    # paths, including a symlink, must not elaborate the source twice.
    file(CREATE_LINK "${work}/load_b.adb" "${work}/body_alias.adb" SYMBOLIC RESULT link_status)
    set(alias_source "")
    if(link_status STREQUAL "0")
        set(alias_source "${work}/body_alias.adb")
    endif()
    scan("${work}/load_b.adb" "${work}/load_b.ads" "${work}/./load_b.adb"
        ${alias_source} "${work}/load_main.adb")
    require_success()
    file(READ "${work}/objects/units.manifest" manifest)
    string(REGEX MATCHALL "elaborate load_b.body\n" bodies "${manifest}")
    list(LENGTH bodies body_count)
    if(NOT body_count EQUAL 1 OR NOT manifest MATCHES "part load_b.body\nrequires load_b.spec\nrequires load_a.spec")
        message(FATAL_ERROR "lost source identity or body dependencies:\n${manifest}")
    endif()
    if(NOT manifest MATCHES "part load_a.spec\nrequires load_b.spec")
        message(FATAL_ERROR "lost specification dependency:\n${manifest}")
    endif()
    scan("${work}/load_b.ads")
    require_success()
    file(READ "${work}/objects/units.manifest" manifest)
    if(NOT manifest MATCHES "elaborate load_b.body")
        message(FATAL_ERROR "explicit specification omitted its body")
    endif()
    scan("${work}/load_b.ads" "${work}/load_b.adb" "${work}/load_main.adb")
    require_success()
elseif(CASE STREQUAL "child")
    scan("${work}/load_parent-child.ads" "${work}/child_main.adb")
    require_success()
    file(READ "${work}/objects/units.manifest" manifest)
    if(NOT manifest MATCHES "part load_parent-child.spec\nrequires load_parent.spec")
        message(FATAL_ERROR "lost parent dependency:\n${manifest}")
    endif()
    file(WRITE "${work}/absent-child.ads" "package Absent.Child is end Absent.Child;\n")
    scan("${work}/absent-child.ads")
    require_error("cannot find parent unit 'Absent'")
elseif(CASE STREQUAL "bundles")
    scan("${work}/bundle_main.adb")
    require_success()
    file(READ "${work}/objects/units.manifest" manifest)
    if(NOT manifest MATCHES "elaborate bundled_a.spec\nelaborate bundled_b.spec\nelaborate bundled_a.body"
        OR NOT manifest MATCHES "part bundled_a.body\nrequires bundled_a.spec\nrequires bundled_b.spec"
        OR NOT manifest MATCHES "part bundled_b.spec\nrequires bundled_a.spec")
        message(FATAL_ERROR "lost per-item identities or context edges:\n${manifest}")
    endif()
    string(REGEX MATCHALL "source [^\n]*bundle_main.adb\n" sources "${manifest}")
    list(LENGTH sources source_count)
    if(NOT source_count EQUAL 1)
        message(FATAL_ERROR "bundle source must be recorded exactly once")
    endif()
    file(WRITE "${work}/duplicate_bundle.adb"
        "package Duplicate_Item is end Duplicate_Item;\npackage Duplicate_Item is end Duplicate_Item;\n")
    scan("${work}/duplicate_bundle.adb")
    require_error("duplicate library unit part 'duplicate_item.spec'")
    file(WRITE "${work}/self_bundle.adb"
        "with Self_Item;\npackage Self_Item is end Self_Item;\npackage Other_Item is end Other_Item;\n")
    scan("${work}/self_bundle.adb")
    require_error("library dependency cycle: self_item.spec -> self_item.spec")
    file(WRITE "${work}/cycle_bundle.adb"
        "with Cycle_Y;\npackage Cycle_X is end Cycle_X;\nwith Cycle_X;\npackage Cycle_Y is end Cycle_Y;\n")
    scan("${work}/cycle_bundle.adb")
    require_error("library dependency cycle:")
    file(WRITE "${work}/child_bundle.adb"
        "package Bundled_Parent.Child is end Bundled_Parent.Child;\npackage Bundled_Parent is end Bundled_Parent;\n")
    scan("${work}/child_bundle.adb")
    require_success()
    file(READ "${work}/objects/units.manifest" manifest)
    if(NOT manifest MATCHES "part bundled_parent-child.spec\nrequires bundled_parent.spec")
        message(FATAL_ERROR "lost bundled parent dependency")
    endif()
    scan("${work}/bundle_client.adb" "${work}/bundle_parts.adb")
    require_success()
    scan("${work}/bundle_parts.adb" "${work}/bundle_client.adb" "${work}/./bundle_parts.adb")
    require_success()
    # Separate compilation must receive the explicit bundle registrations.
    # Verify both executable output and cache invalidation after a bundle edit.
    function(build_bundle expected)
        execute_process(COMMAND "${ADA}" -v -D "${work}/build" -o "${work}/program"
            "${work}/bundle_parts.adb" "${work}/bundle_client.adb"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "bundle build failed: ${output}${errors}")
        endif()
        execute_process(COMMAND "${work}/program" RESULT_VARIABLE status
            OUTPUT_VARIABLE output ERROR_VARIABLE run_errors TIMEOUT 10)
        if(NOT status EQUAL 0 OR NOT output STREQUAL " ${expected}\n")
            message(FATAL_ERROR "bundle output: ${status}: ${output}${run_errors}")
        endif()
        set(commands "${errors}" PARENT_SCOPE)
    endfunction()
    build_bundle(42)
    build_bundle(42)
    if(NOT commands MATCHES "bundle_parts needs no compiling"
        OR NOT commands MATCHES "bundle_client needs no compiling")
        message(FATAL_ERROR "unchanged bundle rebuilt: ${commands}")
    endif()
    file(READ "${work}/bundle_parts.adb" source)
    string(REPLACE ":= 41" ":= 51" source "${source}")
    file(WRITE "${work}/bundle_parts.adb" "${source}")
    build_bundle(52)
    if(commands MATCHES "bundle_parts needs no compiling"
        OR commands MATCHES "bundle_client needs no compiling")
        message(FATAL_ERROR "bundle change did not invalidate its client: ${commands}")
    endif()
    execute_process(COMMAND "${ADAC}" -D "${work}/whole"
        "${work}/bundle_client.adb" "${work}/bundle_parts.adb"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 10)
    require_success()
    foreach(unit bundle_client bundle_parts)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
            "${work}/whole/${unit}.ssa" "${work}/build/${unit}.ssa"
            RESULT_VARIABLE status)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "whole/separate bundle IR differs for ${unit}")
        endif()
    endforeach()
    file(WRITE "${work}/mismatch.ads" "package Mismatch is end Mismatch;\n")
    file(WRITE "${work}/mismatch.adb" "package body Another_Name is end Another_Name;\n")
    scan("${work}/mismatch.ads")
    require_error("does not declare library unit part 'mismatch.body'")
    file(WRITE "${work}/generic_duplicate.adb"
        "generic\npackage Generic_Item is end Generic_Item;\npackage body Generic_Item is end Generic_Item;\npackage body Generic_Item is end Generic_Item;\n")
    scan("${work}/generic_duplicate.adb")
    require_error("duplicate library unit part 'generic_item.body'")
else()
    message(FATAL_ERROR "unknown unit loading case '${CASE}'")
endif()
