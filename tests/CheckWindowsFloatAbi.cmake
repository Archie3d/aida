file(MAKE_DIRECTORY "${WORKDIR}")
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGV}\n${status}\n${output}${errors}")
    endif()
endfunction()
foreach(name floats windowsfloatparameters floatattributes floatattributetasking)
    run("${ADAC}" -o "${WORKDIR}/${name}.ssa" "${SOURCES}/${name}.adb")
    run("${LOWER}" "${WORKDIR}/${name}.ssa" "${WORKDIR}/${name}-win.ssa")
    run("${QBE}" -t amd64_win -o "${WORKDIR}/${name}.s" "${WORKDIR}/${name}-win.ssa")
    file(READ "${WORKDIR}/${name}.s" assembly)
    if(assembly MATCHES "cvtss2sd[ \t]+%[re][a-z0-9]+")
        message(FATAL_ERROR "Float widening reads a general-purpose register")
    endif()
    if(CLANG)
        run("${CLANG}" --target=x86_64-w64-windows-gnu -c "${WORKDIR}/${name}.s" -o "${WORKDIR}/${name}.o")
    endif()
endforeach()
