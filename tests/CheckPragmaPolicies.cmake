foreach(case pragmasuppressed pragmaunsuppressed)
    execute_process(COMMAND "${ADAC}" -o "${WORKDIR}/${case}.ssa" "${SOURCES}/${case}.adb"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${case}: ${status}\n${output}${errors}")
    endif()
    file(READ "${WORKDIR}/${case}.ssa" ir)
    foreach(label outofrange nullaccess)
        string(FIND "${ir}" "${label}" found)
        if(case STREQUAL "pragmasuppressed" AND NOT found EQUAL -1)
            message(FATAL_ERROR "${case} still emits ${label} checks")
        endif()
        if(case STREQUAL "pragmaunsuppressed" AND found EQUAL -1)
            message(FATAL_ERROR "${case} lost ${label} checks")
        endif()
    endforeach()
endforeach()
