set(work "${WORKDIR}/elaboration-pragmas")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
file(COPY "${FIXTURES}/" DESTINATION "${work}")
set(math_library)
if(SEPARATE_LIBM)
    set(math_library -lm)
endif()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGV}\n${status}\n${output}${errors}")
    endif()
    set(actual "${output}" PARENT_SCOPE)
endfunction()
function(build_modes expected)
    run("${ADA}" -D "${work}/objects" -o "${work}/apart" "${work}/ep_main.adb")
    run("${work}/apart")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Separate output: ${actual}, expected ${expected}")
    endif()
    run("${ADA}" -S -o "${work}/whole.s" "${work}/ep_main.adb")
    run("${CC}" -pthread "${work}/whole.s" "${RUNTIME}" ${math_library} -o "${work}/whole")
    run("${work}/whole")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Whole output: ${actual}, expected ${expected}")
    endif()
endfunction()
function(scan)
    run("${ADAC}" --scan -D "${work}/scan" ${ARGN})
    file(READ "${work}/scan/units.manifest" manifest)
    set(manifest "${manifest}" PARENT_SCOPE)
endfunction()
function(reject source pattern)
    file(WRITE "${work}/bad.adb" "${source}")
    execute_process(COMMAND "${ADAC}" --scan -D "${work}/bad" "${work}/bad.adb"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
    if(NOT "${status}" MATCHES "^[1-9][0-9]*$" OR NOT errors MATCHES "${pattern}")
        message(FATAL_ERROR "Expected ${pattern}: ${status}\n${output}${errors}")
    endif()
endfunction()

build_modes(" 42\n")
scan("${work}/ep_client.ads")
if(NOT manifest MATCHES "part ep_client.spec\nrequires ep_model.spec\nrequires ep_model.body\nrequires ep_leaf.spec\nrequires ep_leaf.body")
    message(FATAL_ERROR "Elaborate_All lost transitive body dependencies: ${manifest}")
endif()
# Changing a transitive body must reach the linked program in an incremental build.
file(READ "${work}/ep_leaf.adb" body)
string(REPLACE "41" "51" body "${body}")
file(WRITE "${work}/ep_leaf.adb" "${body}")
build_modes(" 52\n")
# Elaborate adds the named body, but does not add its dependencies' bodies.
file(WRITE "${work}/ep_client.ads" "with Ep_Model;\npragma Elaborate (Ep_Model);\npackage Ep_Client is\n    Value : Integer := Ep_Model.Read;\nend Ep_Client;\n")
scan("${work}/ep_client.ads")
if(NOT manifest MATCHES "part ep_client.spec\nrequires ep_model.spec\nrequires ep_model.body\nend")
    message(FATAL_ERROR "Elaborate dependencies incorrect: ${manifest}")
endif()
build_modes(" 52\n")
# A pragma edit changes the binder constraints and is noticed by the driver.
file(WRITE "${work}/ep_model.ads" "package Ep_Model is\n    pragma Elaborate_Body (Ep_Model);\n    function Read return Integer;\nend Ep_Model;\n")
file(WRITE "${work}/ep_client.ads" "with Ep_Model;\npackage Ep_Client is\n    Value : Integer := Ep_Model.Read;\nend Ep_Client;\n")
build_modes(" 52\n")
file(READ "${work}/objects/units.manifest" manifest)
if(NOT manifest MATCHES "elaborate ep_model.spec\nelaborate ep_model.body\n"
    OR NOT manifest MATCHES "immediate-body ep_model.spec")
    message(FATAL_ERROR "Elaborate_Body adjacency missing: ${manifest}")
endif()
# A structurally valid manifest cannot move another independent part into the pair.
string(REPLACE "elaborate ep_leaf.body\n" "" broken "${manifest}")
string(REPLACE "elaborate ep_model.body\n" "elaborate ep_leaf.body\nelaborate ep_model.body\n" broken "${broken}")
file(WRITE "${work}/objects/units.manifest" "${broken}")
execute_process(COMMAND "${ADAC}" --bind ep_main -D "${work}/objects"
    RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 10)
if(NOT status EQUAL 1 OR NOT errors MATCHES "Elaborate_Body requires body immediately")
    message(FATAL_ERROR "Binder accepted broken adjacency: ${status}: ${errors}")
endif()
file(WRITE "${work}/objects/units.manifest" "${manifest}")

reject("pragma Elaborate (Ep_Model); procedure Bad is begin null; end Bad;" "preceding with clause")
reject("with Ep_Model; pragma Elaborate_All (); procedure Bad is begin null; end Bad;" "expected")
reject("with Ep_Model; pragma Elaborate (1); procedure Bad is begin null; end Bad;" "expected")
reject("with Ep_Model; pragma Elaborate; procedure Bad is begin null; end Bad;" "expected")
reject("with Ep_Model; pragma Elaborate (Ep_Model,); procedure Bad is begin null; end Bad;" "expected")
reject("with Ep_Model; procedure Bad is pragma Elaborate (Ep_Model); begin null; end Bad;" "only allowed in a context clause")
reject("procedure Bad is begin pragma Elaborate_All (Ep_Model); end Bad;" "only allowed in a context clause")
reject("procedure Bad is package Nested is pragma Elaborate_Body; end Nested; begin null; end Bad;" "start of a library package")
reject("package Bad is X : Integer; pragma Elaborate_Body; end Bad;" "start of a library package")
reject("package Bad is private pragma Elaborate_Body; end Bad;" "start of a library package")
reject("package Bad is pragma Elaborate_Body (Ep_Model); end Bad;" "must name its own")
reject("package Bad is pragma Elaborate_Body; pragma Elaborate_Body; end Bad;" "duplicate pragma")
reject("package Bad is pragma Elaborate_Body; end Bad;" "requires a body")
reject("package Bad is pragma Elaborate_Body (Bad, Bad); end Bad;" "expected")
reject("pragma Elaborate_Body; procedure Bad is begin null; end Bad;" "start of a library package")
reject("package Bad is end Bad; pragma Elaborate_Body (Bad);" "requires a subprogram declaration")
reject("function Bad return Integer; pragma Elaborate_Body;" "requires its name")
reject("with Ep_Model; pragma Elaborate_All (Ep_Model.Read); procedure Bad is begin null; end Bad;" "preceding with clause")
reject("with Ep_Model; pragma Elaborate (Unit => Ep_Model); procedure Bad is begin null; end Bad;" "expected")
reject("generic package Bad is pragma Elaborate_Body; end Bad;" "requires a body")
reject("procedure Bad is generic package Nested is pragma Elaborate_Body; end Nested; begin null; end Bad;" "start of a library package")
# A bodyless package is valid for both context pragmas; they do not require a body.
file(WRITE "${work}/ep_empty.ads" "package Ep_Empty is end Ep_Empty;\n")
file(WRITE "${work}/empty_client.adb" "with Ep_Empty; pragma Elaborate (Ep_Empty); pragma Elaborate_All (Ep_Empty); procedure Empty_Client is begin null; end Empty_Client;\n")
scan("${work}/empty_client.adb")
# Validate chained immediate pairs, named child pragmas, and library generic replay
# through the executable fixture above. Also exercise bundle-local context isolation.
file(WRITE "${work}/bundle.adb" "package Pair is pragma Elaborate_Body; end Pair;\npackage body Pair is end Pair;\nwith Pair; pragma Elaborate (Pair); package Client is end Client;\n")
scan("${work}/bundle.adb")
if(NOT manifest MATCHES "elaborate pair.spec\nelaborate pair.body\nelaborate client.spec")
    message(FATAL_ERROR "Bundle pragma ordering lost: ${manifest}")
endif()
reject("with Ep_Model; package First is end First; pragma Elaborate (Ep_Model); package Bad is end Bad;" "preceding with clause")
# Malformed adjacency metadata is rejected by the manifest reader.
# Use the executable manifest rather than the most recent scan.
file(READ "${work}/objects/units.manifest" saved_manifest)
string(REPLACE "immediate-body ep_model.spec" "immediate-body ep_model.spec\nimmediate-body ep_model.spec" malformed "${saved_manifest}")
file(WRITE "${work}/objects/units.manifest" "${malformed}")
execute_process(COMMAND "${ADAC}" --bind ep_main -D "${work}/objects"
    RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 10)
if(NOT status EQUAL 2 OR NOT errors MATCHES "cannot read")
    message(FATAL_ERROR "Binder accepted duplicate adjacency metadata: ${status}: ${errors}")
endif()
file(WRITE "${work}/objects/units.manifest" "${saved_manifest}")
# Direct pragma cycle, transitive body cycle, and impossible immediate-body pair.
file(WRITE "${work}/ep_model.ads" "package Ep_Model is function Read return Integer; end Ep_Model;\n")
file(WRITE "${work}/ep_model.adb" "with Bad; package body Ep_Model is function Read return Integer is begin return 1; end Read; end Ep_Model;\n")
reject("with Ep_Model; pragma Elaborate (Ep_Model); package Bad is end Bad;" "dependency cycle")
file(WRITE "${work}/ep_model.adb" "with Ep_Leaf; package body Ep_Model is function Read return Integer is begin return Ep_Leaf.Read; end Read; end Ep_Model;\n")
file(WRITE "${work}/ep_leaf.adb" "with Bad; package body Ep_Leaf is function Read return Integer is begin return 1; end Read; end Ep_Leaf;\n")
reject("with Ep_Model; pragma Elaborate_All (Ep_Model); package Bad is end Bad;" "dependency cycle")
file(WRITE "${work}/ep_model.ads" "package Ep_Model is pragma Elaborate_Body; function Read return Integer; end Ep_Model;\n")
file(WRITE "${work}/ep_model.adb" "with Bad; package body Ep_Model is function Read return Integer is begin return 1; end Read; end Ep_Model;\n")
reject("with Ep_Model; package Bad is end Bad;" "dependency cycle")
