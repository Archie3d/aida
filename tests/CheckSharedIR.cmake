file(MAKE_DIRECTORY "${WORKDIR}/shared-ir")
execute_process(COMMAND "${ADAC}" -o "${WORKDIR}/shared-ir/scalars.ssa"
    "${FIXTURES}/sharedscalars.adb" RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "shared scalar compilation failed: ${errors}")
endif()
file(READ "${WORKDIR}/shared-ir/scalars.ssa" ir)
foreach(width 8 16 32 64)
    foreach(operation load store)
        if(NOT ir MATCHES "call \\$__ada_atomic_${operation}_${width}\\(")
            message(FATAL_ERROR "missing ${width}-bit shared ${operation}")
        endif()
    endforeach()
endforeach()
# A constant object of an atomic type still requires a memory read.
if(NOT ir MATCHES "call \\$__ada_atomic_load_32\\(l %v.snapshot\\.[0-9]+\\)")
    message(FATAL_ERROR "atomic constant was folded instead of read")
endif()
execute_process(COMMAND "${ADAC}" -o "${WORKDIR}/shared-ir/library.ssa"
    "${FIXTURES}/sharedlibrary.adb" RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "shared library compilation failed: ${errors}")
endif()
file(STRINGS "${WORKDIR}/shared-ir/library.ssa" lines)
foreach(line IN LISTS lines)
    if(line MATCHES "(load[a-z]+|store[a-z]+) .*\\$shared_model__(value|ready)")
        message(FATAL_ERROR "plain memory access bypasses shared lowering: ${line}")
    endif()
endforeach()
