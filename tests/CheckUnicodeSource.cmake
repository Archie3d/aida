set(work "${WORKDIR}/unicode-source")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
function(compile text pattern)
    file(WRITE "${work}/probe.adb" "${text}\n")
    execute_process(COMMAND "${ADAC}" -o "${work}/probe.ssa" "${work}/probe.adb"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 10)
    if(pattern STREQUAL "")
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Unexpected Unicode rejection: ${status}: ${errors}")
        endif()
    elseif(NOT status EQUAL 1 OR NOT errors MATCHES "${pattern}")
        message(FATAL_ERROR "Expected ${pattern}: ${status}: ${errors}")
    endif()
endfunction()
compile("procedure Probe is A‌b : Integer := 1; begin AB := AB + 1; end Probe;" "")
compile("procedure Probe is A_‌_B : Integer; begin null; end Probe;" "consecutive")
compile("procedure Probe is A‿ : Integer; begin null; end Probe;" "identifier cannot end")
compile("procedure Probe is A‿_B : Integer; begin null; end Probe;" "consecutive")
compile("procedure Probe is i‍f : Integer; begin null; end Probe;" "normalize to a reserved word")
compile("procedure Probe is ́X : Integer; begin null; end Probe;" "unexpected Unicode character")
# U+1C90 was unassigned in Unicode 4.0, though later Unicode calls it a letter.
compile("procedure Probe is Ა : Integer; begin null; end Probe;" "unexpected Unicode character")
compile("procedure Probe is C : Character := 'Ω'; begin null; end Probe;" "outside the expected character")
compile("procedure Probe is C : Wide_Character := '😀'; begin null; end Probe;" "outside the expected character")
compile("procedure Probe is S : String := \"Ω\"; begin null; end Probe;" "outside the component subtype")
string(ASCII 192 175 bad)
compile("procedure Probe is S : String := \"${bad}\"; begin null; end Probe;" "invalid UTF-8 source sequence")
string(ASCII 237 160 128 surrogate)
compile("procedure Probe is -- ${surrogate}\nbegin null; end Probe;" "invalid UTF-8 source sequence")
string(ASCII 239 191 190 noncharacter)
compile("procedure Probe is -- ${noncharacter}\nbegin null; end Probe;" "forbidden in Ada source")
string(ASCII 240 159 truncated)
compile("procedure Probe is -- ${truncated}" "invalid UTF-8 source sequence")
string(ASCII 239 187 191 bom)
compile("${bom}procedure Probe is begin null; end Probe;" "")
compile("procedure Probe is Café : Integer := 1; CAFÉ : Integer := 2; begin CAFÉ := CAFÉ; end Probe;" "")
# Canonical Unicode source stems are supported without aliases or case-sensitive
# filename guessing. The explicit bundle test separately checks binder identity.
file(WRITE "${work}/Α.ads" "package Α is Value : constant Integer := 42; end Α;\n")
compile("with α; procedure Probe is X : Integer := Α.Value; begin null; end Probe;" "")

compile("procedure Probe is begin if \"a\" = \"b\" then null; end if; end Probe;" "ambiguous operator")
