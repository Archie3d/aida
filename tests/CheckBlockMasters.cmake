include(${CMAKE_CURRENT_LIST_DIR}/ProcessLimits.cmake)
file(MAKE_DIRECTORY "${WORKDIR}")
foreach(name emptymasterblocks blockmastercalls runtimecomponentcleanup boxtasking anonymousaccess)
    if(name STREQUAL "emptymasterblocks" OR name STREQUAL "blockmastercalls")
        set(directory control_flow)
    elseif(name STREQUAL "anonymousaccess")
        set(directory access)
    else()
        set(directory arrays)
    endif()
    execute_process(COMMAND "${ADAC}" -D "${WORKDIR}/${name}" "${SOURCE_ROOT}/${directory}/${name}.adb"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors
        TIMEOUT ${AIDA_COMPILE_TIMEOUT})
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Master proof compilation failed for ${name}: ${output}${errors}")
    endif()
    file(READ "${WORKDIR}/${name}/${name}.ssa" ir)
    string(REGEX MATCHALL "call \\$__ada_master_enter\\([^\n]*, w 1\\)" lexical "${ir}")
    list(LENGTH lexical count)
    if(name STREQUAL "emptymasterblocks")
        if(NOT count EQUAL 0)
            message(FATAL_ERROR "Proven primitive blocks retain lexical masters")
        endif()
        if(NOT ir MATCHES "call \\$__ada_master_enter\\([^\n]*, w 0\\)")
            message(FATAL_ERROR "Function master was removed outside the block proof")
        endif()
    elseif(name STREQUAL "blockmastercalls")
        if(NOT count EQUAL 2)
            message(FATAL_ERROR "Source calls must retain both masters, including the runtime-looking import; pure inner block must not: ${count}")
        endif()
    elseif(count EQUAL 0)
        message(FATAL_ERROR "Master-sensitive ${name} lost all lexical masters")
    endif()
endforeach()
