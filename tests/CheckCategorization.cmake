set(work "${WORKDIR}/categorization-rules")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
function(source name text)
    file(WRITE "${work}/${name}" "${text}\n")
endfunction()
function(accept name)
    execute_process(COMMAND "${ADAC}" -I "${work}" -o "${work}/out.ssa" "${work}/${name}"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 20)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Expected acceptance of ${name}: ${status}\n${errors}")
    endif()
endfunction()
function(reject name pattern)
    execute_process(COMMAND "${ADAC}" -I "${work}" -o "${work}/out.ssa" "${work}/${name}"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 20)
    if(NOT status EQUAL 1 OR NOT errors MATCHES "${pattern}")
        message(FATAL_ERROR "Expected ${pattern} for ${name}: ${status}\n${errors}")
    endif()
endfunction()
