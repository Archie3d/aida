# Scan and binder both retain the category and enforce global ordering.
source(pre.ads "package Pre is pragma Preelaborate; function Value return Integer; end Pre;")
source(pre.adb "package body Pre is function Value return Integer is begin return 7; end Value; end Pre;")
source(main.adb "with Ordinary; with Pre; procedure Main is begin null; end Main;")
execute_process(COMMAND "${ADAC}" --scan -D "${work}/scan" "${work}/main.adb"
    RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 20)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Categorization scan failed: ${errors}")
endif()
file(READ "${work}/scan/units.manifest" manifest)
if(NOT manifest MATCHES "elaborate pre.spec\nelaborate pre.body\nelaborate ordinary.spec"
    OR NOT manifest MATCHES "part pre.spec\ncategory 1" OR NOT manifest MATCHES "part pre.body\ncategory 1")
    message(FATAL_ERROR "Categorization ordering or metadata lost: ${manifest}")
endif()
# Remove explicit edges to exercise the binder's independent category check.
string(REGEX REPLACE "requires [^\n]*\n" "" broken "${manifest}")
string(REPLACE "elaborate ordinary.spec\n" "" broken "${broken}")
string(REPLACE "format 6\n" "format 6\nelaborate ordinary.spec\n" broken "${broken}")
file(WRITE "${work}/scan/units.manifest" "${broken}")
execute_process(COMMAND "${ADAC}" --bind main -D "${work}/scan"
    RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 20)
if(NOT status EQUAL 1 OR NOT errors MATCHES "must precede ordinary parts")
    message(FATAL_ERROR "Binder accepted ordinary-before-preelaborated order: ${status}: ${errors}")
endif()
