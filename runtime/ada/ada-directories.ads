with Ada.Calendar;
with Ada.IO_Exceptions;
with Ada.Finalization;
with Ada.Strings.Unbounded;
with System;
package Ada.Directories is
    function Current_Directory return String;
    pragma Import (C, Current_Directory, "__ada_host_current_directory");
    procedure Set_Directory (Directory : String);
    pragma Import (C, Set_Directory, "__ada_host_set_directory");
    procedure Create_Directory (New_Directory : String; Form : String := "");
    pragma Import (C, Create_Directory, "__ada_host_create_directory");
    procedure Delete_Directory (Directory : String);
    pragma Import (C, Delete_Directory, "__ada_host_delete_directory");
    procedure Create_Path (New_Directory : String; Form : String := "");
    pragma Import (C, Create_Path, "__ada_host_create_path");
    procedure Delete_Tree (Directory : String);
    pragma Import (C, Delete_Tree, "__ada_host_delete_tree");
    procedure Delete_File (Name : String);
    pragma Import (C, Delete_File, "__ada_host_delete_file");
    procedure Rename (Old_Name, New_Name : String);
    pragma Import (C, Rename, "__ada_host_rename");
    procedure Copy_File (Source_Name, Target_Name : String; Form : String := "");
    pragma Import (C, Copy_File, "__ada_host_copy_file");
    function Full_Name (Name : String) return String;
    pragma Import (C, Full_Name, "__ada_host_full_name");
    function Simple_Name (Name : String) return String;
    pragma Import (C, Simple_Name, "__ada_host_simple_name");
    function Containing_Directory (Name : String) return String;
    pragma Import (C, Containing_Directory, "__ada_host_containing_directory");
    function Extension (Name : String) return String;
    pragma Import (C, Extension, "__ada_host_extension");
    function Base_Name (Name : String) return String;
    pragma Import (C, Base_Name, "__ada_host_base_name");
    function Compose (Containing_Directory : String := ""; Name : String;
                      Extension : String := "") return String;
    pragma Import (C, Compose, "__ada_host_compose");
    type File_Kind is (Directory, Ordinary_File, Special_File);
    type File_Size is range 0 .. 9223372036854775807;
    function Exists (Name : String) return Boolean;
    pragma Import (C, Exists, "__ada_host_exists");
    function Kind (Name : String) return File_Kind;
    pragma Import (C, Kind, "__ada_host_kind");
    function Size (Name : String) return File_Size;
    pragma Import (C, Size, "__ada_host_size");
    function Modification_Time (Name : String) return Ada.Calendar.Time;
    type Directory_Entry_Type is limited private;
    type Filter_Type is array (File_Kind) of Boolean;
    type Search_Type is limited private;
    procedure Start_Search (Search : in out Search_Type; Directory, Pattern : String;
                            Filter : Filter_Type := (others => True));
    procedure End_Search (Search : in out Search_Type);
    function More_Entries (Search : Search_Type) return Boolean;
    procedure Get_Next_Entry (Search : in out Search_Type; Directory_Entry : out Directory_Entry_Type);
    procedure Search (Directory, Pattern : String; Filter : Filter_Type := (others => True);
                      Process : not null access procedure (Directory_Entry : Directory_Entry_Type));
    function Simple_Name (Directory_Entry : Directory_Entry_Type) return String;
    function Full_Name (Directory_Entry : Directory_Entry_Type) return String;
    function Kind (Directory_Entry : Directory_Entry_Type) return File_Kind;
    function Size (Directory_Entry : Directory_Entry_Type) return File_Size;
    function Modification_Time (Directory_Entry : Directory_Entry_Type) return Ada.Calendar.Time;
    Status_Error : exception renames Ada.IO_Exceptions.Status_Error;
    Name_Error : exception renames Ada.IO_Exceptions.Name_Error;
    Use_Error : exception renames Ada.IO_Exceptions.Use_Error;
    Device_Error : exception renames Ada.IO_Exceptions.Device_Error;
private
    type Search_Guard is new Ada.Finalization.Limited_Controlled with record
        Handle : System.Address := null;
    end record;
    overriding procedure Finalize (Object : in out Search_Guard);
    type Search_Type is limited record
        State : Search_Guard;
    end record;
    type Directory_Entry_Type is limited record
        Valid : Boolean := False;
        Name : Ada.Strings.Unbounded.Unbounded_String;
        File_Type : File_Kind := Ordinary_File;
        Length : File_Size := 0;
        Modified : Ada.Calendar.Time;
        Has_Time : Boolean := False;
    end record;
end Ada.Directories;
